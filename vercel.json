{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm --prefix Pixel-Store run build",
  "outputDirectory": "Pixel-Store/dist",
  "installCommand": "npm --prefix Pixel-Store install",
  "framework": "vite",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/((?!.*\\.[\\w]+$).*)",
      "destination": "/index.html"
    }
  ]
}
